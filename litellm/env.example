# ~/.litellm/env — secrets and runtime settings for LiteLLM and the hooks. Never commit the real file.
#   cp litellm/env.example ~/.litellm/env && chmod 600 ~/.litellm/env
# start.sh exports everything here into LiteLLM; Wanda and suite.py read it too.

# Clients send this as the API key (ANTHROPIC_AUTH_TOKEN / OPENAI_API_KEY). Generate one:
#   python3 -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
LITELLM_MASTER_KEY=sk-change-me
LITELLM_PORT=4000

# Cloud overflow (optional), e.g. OMNIROUTE_BASE=https://omniroute.example:20128/v1. Any OpenAI-compatible
# endpoint works; OmniRoute adds combo stats in Wanda and the video endpoint the media hook uses.
# Leave both empty to run local-only (then set route mode to local-only and media mode to off).
OMNIROUTE_BASE=
OMNIROUTE_KEY=
# Claude-style clients (/v1/messages) reach the cloud endpoint through LiteLLM's chat-completions bridge
# (OmniRoute's /v1/responses drops tool names from some providers' tool calls). off = LiteLLM's default.
ULTRON_CHAT_BRIDGE=on

# Where generated images/videos are linked from (Caddy serves ~/.ultron/media at /media/).
ULTRON_MEDIA_PUBLIC=https://your-mac.example.ts.net/media

# Hook defaults, used when the matching ~/.ultron/*-mode file is missing (the Wanda panel writes those).
ULTRON_ADMIT_MODE=shadow
LOOP_BREAKER_MODE=enforce
ULTRON_MEDIA_MODE=shadow
ULTRON_RESCUE_MODE=enforce

# Memory guard: overflow to cloud while headroom (free + file-backed pages) is below this many GB,
# or swap-outs exceed this many MB/s. 0 turns a check off.
ULTRON_MEM_LOW_GB=4
ULTRON_SWAPOUT_MB_S=16
# Once tripped, it holds until headroom is back over this many GB (so it doesn't flap).
ULTRON_MEM_CLEAR_GB=5
# Kernel memory-pressure level that trips it: 4 = critical. 2 (warn) is normal on a Mac with three tiers
# loaded; warn only stops cold loads.
ULTRON_PRESSURE_TRIP=4
# Memory gate: a request that must stay local waits up to this many seconds while another tier
# serves one (two big prefills at once can run the GPU out of memory). 0 turns it off.
ULTRON_MEM_WAIT_S=300
